<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.5.7</Version>
    <BeautyLibsDir>./lib</BeautyLibsDir>
    <BeautyOnPublishOnly>true</BeautyOnPublishOnly>
    <BeautyUsePatch>true</BeautyUsePatch>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.16" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.16" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.16" />
    <PackageReference Include="nulastudio.NetBeauty" Version="2.1.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VintageModUpdater.Core\VintageModUpdater.Core.csproj" />
  </ItemGroup>

</Project>
